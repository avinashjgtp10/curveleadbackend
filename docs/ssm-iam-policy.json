{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CurveLeadSSMParameterRead",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:us-east-1:<AWS_ACCOUNT_ID>:parameter/curvelead/backend/<ENV>/*"
    },
    {
      "Sid": "CurveLeadSSMSecureStringDecrypt",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-1:<AWS_ACCOUNT_ID>:key/*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.us-east-1.amazonaws.com" }
      }
    }
  ]
}
